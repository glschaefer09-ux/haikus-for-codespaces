# Solana cluster: devnet | testnet | mainnet-beta
SOLANA_CLUSTER=devnet
# Optional: override the RPC URL derived from SOLANA_CLUSTER
SOLANA_RPC_URL=

# Optional: override the payer keypair path. Defaults to the Solana CLI's
# own config file (~/.config/solana/id.json) when unset.
PAYER_KEYPAIR_PATH=
TREASURY_KEYPAIR_PATH=./token/keys/treasury-keypair.json
MINT_KEYPAIR_PATH=./token/keys/mint-keypair.json

# --- CONFIRM BEFORE RUNNING `npm run token:create` ---
TOKEN_NAME="Gator Coin"
TOKEN_SYMBOL=GATOR
TOKEN_DECIMALS=6
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_METADATA_URI=https://raw.githubusercontent.com/glschaefer09-ux/haikus-for-codespaces/main/token/metadata/gator-coin.json
